# ==============================================================================
# LIBROBE BACKEND - CẤU HÌNH BIẾN MÔI TRƯỜNG KẾT NỐI SUPABASE
# ==============================================================================

PORT=3000
JWT_SECRET=

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL CONNECTION STRINGS
# Lưu ý: Ký tự $ trong mật khẩu được URL-encode thành %24 để tránh lỗi kết nối
# ------------------------------------------------------------------------------
# VÀO CONNECT -> CHỌN ORM -> CHỌN PRISMA
# 1. DATABASE_URL: Dùng Connection Pooling (Port 6543)
DATABASE_URL=

# 2. DIRECT_URL: Kết nối Session-mode pooler (Port 5432) cho Prisma Migrations & db push
DIRECT_URL=

SUPABASE_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Password reset email
APP_BASE_URL=http://localhost:3000
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=
RESET_TOKEN_TTL_MINUTES=20
