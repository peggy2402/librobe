# ==============================================================================
# LIBROBE BACKEND - CẤU HÌNH BIẾN MÔI TRƯỜNG KẾT NỐI SUPABASE
# ==============================================================================

PORT=3000
JWT_SECRET=

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL CONNECTION STRINGS
# Lưu ý: Ký tự $ trong mật khẩu được URL-encode thành %24 để tránh lỗi kết nối
# ------------------------------------------------------------------------------
# VÀO CONNECT -> CHỌN ORM -> CHỌN PRISMA
# 1. DATABASE_URL: Dùng Connection Pooling (Port 6543)
DATABASE_URL=

# 2. DIRECT_URL: Kết nối Session-mode pooler (Port 5432) cho Prisma Migrations & db push
DIRECT_URL=

SUPABASE_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# GỬI EMAIL ĐẶT LẠI MẬT KHẨU (forgot-password / reset-password)
# ------------------------------------------------------------------------------
# Địa chỉ gốc của ứng dụng, dùng để sinh link đặt lại mật khẩu trong email
APP_BASE_URL=http://localhost:3000
# Kênh gửi mail: console (in ra log khi phát triển) hoặc resend
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=
# Thời gian hiệu lực của token đặt lại mật khẩu (phút)
RESET_TOKEN_TTL_MINUTES=20

# ------------------------------------------------------------------------------
# CHÍNH SÁCH MƯỢN / TRẢ / GIA HẠN / PHẠT
# Tất cả đều TÙY CHỌN - bỏ trống sẽ dùng giá trị mặc định ghi trong ngoặc.
# Thay đổi ở đây có hiệu lực cho cả luồng phiếu mượn lẻ (/api/borrowings)
# và luồng phiếu mượn ERP (/api/borrowing-slips).
# ------------------------------------------------------------------------------

# Thời hạn mượn mặc định khi request không truyền durationDays (14 ngày)
LOAN_DEFAULT_DAYS=14
# Thời hạn mượn tối đa thủ thư được phép cấp; vượt quá sẽ trả lỗi 400 (30 ngày)
LOAN_MAX_DAYS=30

# Mức phạt trễ hạn: VNĐ / ngày / cuốn (5000)
LOAN_FINE_PER_DAY=5000
# Số ngày ân hạn không tính phạt sau hạn trả (0 = phạt ngay ngày đầu trễ)
LOAN_FINE_GRACE_DAYS=0

# Số lần gia hạn tối đa cho mỗi lượt mượn (1)
LOAN_RENEW_MAX_COUNT=1
# Số ngày cộng thêm mặc định mỗi lần gia hạn (7)
LOAN_RENEW_DAYS=7
# Số ngày gia hạn tối đa cho mỗi lần (14)
LOAN_RENEW_MAX_DAYS=14
# Chỉ cho gia hạn khi còn tối đa N ngày tới hạn trả (0 = không giới hạn thời điểm)
LOAN_RENEW_WINDOW_DAYS=0
# Chặn gia hạn khi cuốn sách đang có độc giả khác đặt trước hợp lệ (true)
LOAN_RENEW_BLOCK_WHEN_RESERVED=true

# Chặn mượn mới khi độc giả còn nợ tiền phạt chưa thanh toán (true)
LOAN_BLOCK_BORROW_ON_UNPAID_FINE=true
# Chặn mượn mới khi độc giả đang có sách quá hạn chưa trả (true)
LOAN_BLOCK_BORROW_ON_OVERDUE=true

# Hạn mức mượn mặc định khi tạo thẻ độc giả mới (5 cuốn)
MEMBER_DEFAULT_BORROW_LIMIT=5

# Số ngày giữ sách cho độc giả đặt trước kể từ khi phiếu chuyển sang READY (3)
RESERVATION_HOLD_DAYS=3
# Số phiếu đặt trước đang hoạt động tối đa của một độc giả (3)
RESERVATION_MAX_ACTIVE=3
